{
  "include": [
    "vite.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  }
}